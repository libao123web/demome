{
  "name": "pims",
  "version": "1.0.0",
  "description": "人员信息管理系统 - Personnel Information Management System",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc && vite build",
    "build:static": "vite build --config vite.config.static.ts",
    "build:pwa": "vite build --config vite.config.pwa.ts",
    "build:app": "vite build --config vite.config.app.ts",
    "build:hbuilder": "vite build --config vite.config.hbuilder.ts",
    "build:all": "npm run build:static && npm run build:pwa",
    "build:check": "vue-tsc && npm run build:all",
    "preview": "vite preview",
    "preview:static": "vite preview --outDir dist-static",
    "preview:pwa": "vite preview --outDir dist-pwa",
    "cap:init": "npx cap init PIMS com.pims.app --web-dir dist-app",
    "cap:android": "npx cap add android",
    "cap:ios": "npx cap add ios",
    "cap:sync": "npx cap sync",
    "cap:open:android": "npx cap open android",
    "cap:open:ios": "npx cap open ios",
    "app:build": "npm run build:app && npm run cap:sync",
    "ios:build": "npm run build:app && npx cap sync ios",
    "ios:open": "npx cap open ios",
    "android:build": "npm run build:app && npx cap sync android",
    "android:open": "npx cap open android",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@ant-design/icons-vue": "^7.0.1",
    "@capacitor/android": "5.7.8",
    "@capacitor/cli": "5.7.8",
    "@capacitor/core": "5.7.8",
    "@capacitor/ios": "5.7.8",
    "ant-design-vue": "^4.1.2",
    "axios": "^1.6.7",
    "dayjs": "^1.11.10",
    "echarts": "^6.0.0",
    "mockjs": "^1.1.0",
    "pinia": "^2.1.7",
    "vue": "^3.4.21",
    "vue-echarts": "^8.0.1",
    "vue-router": "^4.3.0",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@types/mockjs": "^1.0.10",
    "@types/node": "^25.2.0",
    "@vitejs/plugin-vue": "^5.0.4",
    "autoprefixer": "^10.4.18",
    "jsdom": "^24.0.0",
    "less": "^4.2.0",
    "postcss": "^8.4.35",
    "tailwindcss": "^3.4.1",
    "typescript": "^5.3.3",
    "vite": "^5.1.4",
    "vite-plugin-pwa": "^0.19.2",
    "vitest": "^1.3.0",
    "vue-tsc": "^2.0.6"
  }
}
